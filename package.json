{
  "name": "arthur-s-bot",
  "version": "1.0.0",
  "description": "Bots Minecraft de test pour serveurs : modes prédéfinis, essaims multi-bots, toutes versions (1.8.8 → 26.x) et programmation visuelle de comportements par graphes.",
  "main": "src/index.js",
  "bin": {
    "arthur-bot": "bin/arthur-bot.js"
  },
  "scripts": {
    "start": "node bin/arthur-bot.js start",
    "web": "node bin/arthur-bot.js start --no-repl",
    "test": "node --test \"test/*.test.js\"",
    "versions": "node bin/arthur-bot.js versions"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arthur-91140/Arthur-s-Bot.git"
  },
  "keywords": [
    "minecraft",
    "bot",
    "mineflayer",
    "testing",
    "visual-programming"
  ],
  "author": "Arthur",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/Arthur-91140/Arthur-s-Bot/issues"
  },
  "homepage": "https://github.com/Arthur-91140/Arthur-s-Bot#readme",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "express": "^5.3.0",
    "minecraft-data": "^3.117.0",
    "mineflayer": "^4.39.0",
    "mineflayer-armor-manager": "^2.0.1",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "prismarine-item": "^1.18.0",
    "socket.io": "^4.8.4",
    "vec3": "^0.2.0"
  }
}
